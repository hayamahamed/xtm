[org.gnome.shell]
enabled-extensions=['blur-my-shell@aunetx', 'dash-to-dock@micxgx.gmail.com']

# ---- Blur my Shell ----
# Pin the settings version so the extension has no reason to run its migration on a fresh profile
[org.gnome.shell.extensions.blur-my-shell]
settings-version=2

# Top bar only: dynamic, sigma 0, background blur on, transparent
[org.gnome.shell.extensions.blur-my-shell.panel]
blur=true
static-blur=false
sigma=0
brightness=1.0
override-background=true
style-panel=0

# Stay off the dock
[org.gnome.shell.extensions.blur-my-shell.dash-to-dock]
blur=false
override-background=false

[org.gnome.shell.extensions.blur-my-shell.overview]
blur=false

[org.gnome.shell.extensions.blur-my-shell.appfolder]
blur=false

[org.gnome.shell.extensions.blur-my-shell.lockscreen]
blur=false

[org.gnome.shell.extensions.blur-my-shell.screenshot]
blur=false

[org.gnome.shell.extensions.blur-my-shell.applications]
blur=false

[org.gnome.shell.extensions.blur-my-shell.window-list]
blur=false

[org.gnome.shell.extensions.blur-my-shell.coverflow-alt-tab]
blur=false

# ---- Dash to Dock ----
[org.gnome.shell.extensions.dash-to-dock]
show-trash=false
show-mounts=false
background-opacity=0
