[Unit]
Description=Force SELinux enforcing and lock policy changes
After=local-fs.target
ConditionSecurity=selinux
ConditionPathIsMountPoint=!/run/initramfs/live

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/setenforce 1
ExecStart=/usr/sbin/setsebool secure_mode_policyload=on

[Install]
WantedBy=multi-user.target
